{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@agenetix/docs": ["../dist/index"],
      "@agenetix/docs/*": ["../dist/*"],
      "@agenetix/docs/styles.css": ["../dist/styles.css"]
    },
    "noEmit": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
